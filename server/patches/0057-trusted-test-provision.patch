+// Trusted server screenplay only. Normal training checks and global cap remain unchanged.
+int LuaPlayerObject::setSkillPoints(lua_State* L) {
+ if(lua_gettop(L)!=2 || !lua_isnumber(L,-1)){lua_pushboolean(L,false);return 1;}
+ double points=lua_tonumber(L,-1);
+ if(!std::isfinite(points) || points<0 || points>10000 || points!=std::floor(points) || !realObject){lua_pushboolean(L,false);return 1;}
+ Locker lock(realObject);realObject->setSkillPoints(static_cast<int>(points));realObject->updateToDatabase();lua_pushboolean(L,true);return 1;
+}
