+#pragma once
+// Per-native-client presentation stream. Never reads ClientCore's shared JSON vars.
+#include "engine/util/JSONSerializationType.h"
+#include <mutex>
+#include <thread>
+#include <atomic>
+#include <map>
+#include <chrono>
+#include <fstream>
+#include <cstdio>
+#include <cstdint>
+namespace swgxr {
+class NativeMotionStream {
+ using Json=JSONSerializationType;
+ struct Entry { Json row; double at; };
+ std::mutex mutex;
+ std::map<uint64_t,Entry> rows;
+ uint64_t sequence=0,epoch=0;
+ std::string zone;
+ static double now(){return std::chrono::duration<double>(std::chrono::system_clock::now().time_since_epoch()).count();}
+public:
+ static NativeMotionStream& instance(){static NativeMotionStream state;return state;}
+ void scene(std::string terrain){std::lock_guard<std::mutex> lock(mutex);rows.clear();++epoch;auto slash=terrain.find_last_of('/');zone=terrain.substr(slash==std::string::npos?0:slash+1);auto dot=zone.find('.');if(dot!=std::string::npos)zone.resize(dot);}
+ void remove(uint64_t id){std::lock_guard<std::mutex> lock(mutex);rows.erase(id);}
+ void push(uint64_t id,uint64_t parent,double x,double z,double y,uint32_t counter,int speed,unsigned heading){
+  std::lock_guard<std::mutex> lock(mutex);
+  auto old=rows.find(id);
+  if(old!=rows.end() && old->second.row["cell_id"]==std::to_string(parent)){
+   uint32_t previous=old->second.row["movement_counter"].get<uint32_t>();
+   if(int32_t(counter-previous)<=0)return;
+  }
+  if(rows.size()>=512 && old==rows.end()){
+   auto oldest=rows.begin();for(auto it=rows.begin();it!=rows.end();++it)if(it->second.at<oldest->second.at)oldest=it;rows.erase(oldest);
+  }
+  rows[id]={{{"id",std::to_string(id)},{"cell_id",std::to_string(parent)},{"position",{x,z,y}},{"movement_counter",counter},{"speed",std::max(0,speed)},{"heading_radians",heading*6.283/100.},{"sequence",++sequence}},now()};
+ }
+ Json snapshot(uint64_t character){
+  std::lock_guard<std::mutex> lock(mutex);double stamp=now();Json out={{"source_kind","core3_motion_v1"},{"character_id",std::to_string(character)},{"epoch",epoch},{"zone",zone},{"written_at",stamp},{"actors",Json::array()}};
+  for(auto it=rows.begin();it!=rows.end();){if(stamp-it->second.at>3){it=rows.erase(it);continue;}auto row=it->second.row;row["age_ms"]=std::max(0.,(stamp-it->second.at)*1000);out["actors"].push_back(row);++it;}return out;
+ }
+ class Publisher {
+  std::atomic<bool> running{true};std::thread worker;
+ public:
+  Publisher(const std::string& directory,uint64_t character):worker([this,directory,character]{
+   while(running){try{auto value=NativeMotionStream::instance().snapshot(character);std::ofstream file(directory+"/motion.tmp");file<<value.dump();file.close();if(file)std::rename((directory+"/motion.tmp").c_str(),(directory+"/motion.json").c_str());}catch(...){/* Presentation failure never interrupts native transactions. */}std::this_thread::sleep_for(std::chrono::milliseconds(25));}
+  }){}
+  ~Publisher(){running=false;worker.join();}
+  Publisher(const Publisher&)=delete;Publisher& operator=(const Publisher&)=delete;
+ };
+};
+}
