; SWG XR native client feasibility prototype.
config_version=5
[application]
config/name="SWG XR · Mos Eisley"
config/icon="res://resources/icons/swgxr.png"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
[audio]
; Permit explicit voice capture; voice starts muted and opens input on demand.
driver/enable_input=true
[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"
[gui]
theme/custom="res://resources/fonts/ui_theme.tres"
theme/custom_font="res://resources/fonts/Jupiteroid-Regular.ttf"
[rendering]
; RD reserves16 vec4 slots per geometry instance. 524288 slots =8MiB GPU,
; ~32767 instance blocks after globals; preserves portal/indoor parameters.
limits/global_shader_variables/buffer_size=524288
rendering_device/driver="vulkan"
rendering_device/fallback_to_opengl3=false
rendering_device/fallback_to_d3d12=false
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=false
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=false
[physics]
common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"
[environment]
defaults/default_clear_color=Color(0.12,0.15,0.18,1)

[autoload]
SWGSpatialAudio="*res://audio/spatial_audio.gd"
SWGUIAudio="*res://audio/ui_audio.gd"
RenderPolicy="*res://scripts/render_policy.gd"
XRToolsUserSettings="*res://addons/godot-xr-tools/user_settings/user_settings.gd"
XRToolsRumbleManager="*res://addons/godot-xr-tools/rumble/rumble_manager.gd"
[editor_plugins]
enabled=PackedStringArray("res://addons/godot-xr-tools/plugin.cfg")
[xr]
openxr/reference_space=2
openxr/enabled=true
; Retain native density-map allocation even when saved viewport foveation is Off.
openxr/foveation_level=2
openxr/foveation_dynamic=false
openxr/foveation_eye_tracked=true
openxr/extensions/eye_gaze_interaction=true
openxr/default_action_map="res://openxr_action_map.tres"
openxr/extensions/hand_tracking_controller_data_source=true
openxr/extensions/hand_tracking_unobstructed_data_source=true
openxr/extensions/hand_tracking=true
shaders/enabled=true
[layer_names]
3d_physics/layer_1="SWG structures"
3d_physics/layer_2="SWG terrain"
3d_physics/layer_4="Local combat targets"
3d_physics/layer_20="XR player"
3d_physics/layer_21="XR pointable"
3d_physics/layer_23="XR UI"

[shader_globals]
swg_space_basis_x={
"type": "vec3",
"value": Vector3(1, 0, 0)
}
swg_space_basis_y={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
swg_space_basis_z={
"type": "vec3",
"value": Vector3(0, 0, 1)
}
swg_portal_view_a={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
swg_portal_view_b={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
swg_portal_data={
"type": "sampler2D",
"value": ""
}
swg_environment_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
swg_indoor_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
swg_daylight={
"type": "float",
"value": 1.0
}
