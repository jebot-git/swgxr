+#pragma once
+#include <algorithm>
+#include <cmath>
+// SWGXR Doctor progression. Ordinary Medic values and unrelated ranged care remain intact.
+namespace corecu { namespace doctorcare {
+inline double multiplier(int stage){return 1.+.10*std::max(0,std::min(5,stage));}
+inline int potency(int amount,int stage){return amount<=0?amount:int(std::min(1073741823.,std::round(amount*multiplier(stage))));}
+inline int grogginess(int base){return -std::max(1,int(std::round(std::max(1,base)*.05)));}
+} }
