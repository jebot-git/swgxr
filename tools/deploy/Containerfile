FROM docker.io/library/debian@sha256:d5ce19d4736f0ebbacd686d1040271a5aeb0cc920f5990c1bfae1717627f0674
ENV DEBIAN_FRONTEND=noninteractive
RUN printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d && chmod 755 /usr/sbin/policy-rc.d \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      mariadb-server mariadb-client libboost-thread1.83.0 libboost-atomic1.83.0 libboost-program-options1.83.0 \
      libdb5.3t64 libmariadb3 liblua5.3-0 libssl3t64 libjemalloc2 libatomic1 \
      libstdc++6 zlib1g libzstd1 python3 ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace/vendor/Core3/MMOCoreORB/bin
CMD ["sleep", "infinity"]
