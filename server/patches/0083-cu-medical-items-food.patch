+#include "server/zone/objects/tangible/pharmaceutical/StimPack.h"
+#include "server/zone/objects/tangible/pharmaceutical/RangedStimPack.h"
+#include "server/zone/objects/tangible/pharmaceutical/WoundPack.h"
