+int DirectorManager::grantCreaturePet(lua_State* L) {
+ if(lua_gettop(L)!=2 || !lua_islightuserdata(L,1) || !lua_islightuserdata(L,2)){lua_pushboolean(L,false);return 1;}
+ auto owner=static_cast<SceneObject*>(lua_touserdata(L,1)),object=static_cast<SceneObject*>(lua_touserdata(L,2));
+ if(!owner || !owner->isPlayerCreature() || !object || !object->isCreature()){lua_pushboolean(L,false);return 1;}
+ auto player=owner->asCreatureObject();auto pet=cast<Creature*>(object);Locker lock(player);Locker petLock(pet,player);
+ auto datapad=player->getSlottedObject("datapad");
+ if(!player->getZone() || player->getZone()!=pet->getZone() || player->getParent()!=pet->getParent() || !player->isInRange(pet,8) || player->isDead() || pet->isDead() || !pet->isBaby() || pet->getControlDevice().get()!=nullptr || pet->getLinkedCreature().get()!=nullptr || !pet->getCreatureTemplate() || !pet->canTameMe(player) || pet->getChanceToTame(player)<=0 || !player->hasSkill("outdoors_creaturehandler_novice") || !datapad || datapad->getContainerObjectsSize()>=datapad->getContainerVolumeLimit()){lua_pushboolean(L,false);return 1;}
+ Reference<TameCreatureTask*> task=new TameCreatureTask(pet,player,pet->getPvpStatusBitmask(),true,true);task->success(true);
+ auto device=pet->getControlDevice().get().castTo<PetControlDevice*>();bool okay=device && device->getParent().get()==datapad && device->getPetType()==PetManager::CREATUREPET && pet->getLinkedCreature().get()==player;
+ if(okay){device->updateToDatabase();pet->updateToDatabase();}lua_pushboolean(L,okay);return 1;
+}
