+#ifndef SWGXR_PLANETS_H
+#define SWGXR_PLANETS_H
+#include "server/zone/Zone.h"
+#include "server/zone/objects/creature/CreatureObject.h"
+// Ground-zone capability does not enable a zone. Core3's loaded zone instance,
+// original routes and current character location remain authoritative.
+class SwgxrPlanets {
+public:
+ static bool supportedName(const std::string& value){for(auto name:{"tatooine","naboo","corellia","rori","talus","dantooine","dathomir","endor","lok","yavin4"})if(value==name)return true;return false;}
+ static bool supported(const String& value){return supportedName(value.toCharArray());}
+ static String require(CreatureObject* c,const JSONSerializationType& request=JSONSerializationType::object()){
+  if(c==nullptr || c->getZone()==nullptr || !supported(c->getZone()->getZoneName()))throw std::runtime_error("supported_ground_zone_required");
+  const auto zone=c->getZone()->getZoneName();
+  for(auto field:{"zone","planet"})if(request.contains(field)){
+   if(!request[field].is_string() || request[field].get<std::string>()!=zone.toCharArray())throw std::runtime_error("native_source_zone_mismatch");
+  }
+  return zone;
+ }
+ static std::string name(CreatureObject* c){return require(c).toCharArray();}
+};
+#endif
