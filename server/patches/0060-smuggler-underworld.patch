+MissionObject* MissionManagerImplementation::swgxrCreateUnderworldMission(CreatureObject* player, int rewardCredits) {
+ auto datapad=player->getSlottedObject("datapad");if(datapad==nullptr)return nullptr;
+ int count=0;for(int i=0;i<datapad->getContainerObjectsSize();++i)if(datapad->getContainerObject(i)->isMissionObject())++count;
