[Unit]
Description=SWGXR encrypted voice relay
Requires=swgxr-gateway.service
After=swgxr-gateway.service
PartOf=swgxr.target swgxr-gateway.service

[Service]
Type=exec
User=blux
Group=blux
WorkingDirectory=@ROOT@
EnvironmentFile=-@ROOT@/runtime/remote/capacity.env
ExecStart=/usr/bin/python3 @ROOT@/server/voice_relay.py --config @ROOT@/runtime/remote/gateway.json --bind 0.0.0.0 --port 18444
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
LimitNOFILE=256
MemoryHigh=128M
MemoryMax=192M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@ROOT@/runtime/auth
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
