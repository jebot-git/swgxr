+float ArmorObjectImplementation::getSwgxrBaseScore() const {
+    const auto ref=SwgxrArmour::reference(_this.getReferenceUnsafeStaticCast());
+    if (!ref) return 0;
+    const double fallback=std::max(kinetic,energy);
+    return swgxr::armour::baseScore(*ref,baseProtection,fallback);
+}
+
+float ArmorObjectImplementation::getSwgxrProtectionScore(int type) const {
+    const auto ref=SwgxrArmour::reference(_this.getReferenceUnsafeStaticCast());
+    if (!ref || isBroken()) return 0;
+    const int channel=swgxr::armour::canonical(type);
+    double layer=0;
+    switch(channel) {
+      case 1: layer=kinetic; break; case 2: layer=energy; break;
+      case 32: layer=heat; break; case 64: layer=cold; break;
+      case 128: layer=acid; break; case 256: layer=electricity; break;
+    }
+    // Template/loot defaults store full resistance in channels, unlike crafted
+    // items. Do not count that fallback twice as both quality and a layer.
+    double specialDelta=0;
+    if(baseProtection<=0) layer=0;
+    else if(isSpecial(channel)) specialDelta=1000*(
+      swgxr::armour::quality(specialProtection,ref->specialMinimum,ref->specialMaximum)-
+      swgxr::armour::quality(baseProtection,ref->minimum,ref->maximum));
+    const double legacy=sliced?std::max(1.f,effectivenessSlice):1;
+    const double slice=legacy*SwgxrSlicingStats::factor(_this.getReferenceUnsafeStaticCast(),"protection_pct");
+    return swgxr::armour::score(*ref,channel,getSwgxrBaseScore(),specialDelta,layer,slice);
+}
+
+float ArmorObjectImplementation::getSwgxrHindrance(int kind) const {
+    const auto ref=SwgxrArmour::reference(_this.getReferenceUnsafeStaticCast());
+    if(!ref || isBroken() || hitLocation==0)return 0;
+    const double enc=std::max(0, getHealthEncumbrance())+std::max(0,getActionEncumbrance())+std::max(0,getMindEncumbrance());
+    const double quality=1-swgxr::armour::quality(enc,ref->encumbranceBest,ref->encumbranceWorst);
+    const auto p=swgxr::armour::penalties(ref->kind,getSwgxrBaseScore(),quality,0);
+    return 1-(kind==0?p.movement:kind==1?p.output:p.recovery);
+}
+
 bool ArmorObjectImplementation::isVulnerable(int type) const {
+    if(SwgxrArmour::reference(_this.getReferenceUnsafeStaticCast())) return isBroken();
 	return isBroken() || (!isSpecial(type) && (vulnerabilites & type));
 }
 
