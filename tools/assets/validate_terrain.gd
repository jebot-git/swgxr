extends SceneTree
# Run: godot --headless --xr-mode off --path client --script ../tools/assets/validate_terrain.gd
# Uses source Core3 samples when generated by tools/terrain/core3_height_reference.
func _initialize():
 var base=ProjectSettings.globalize_path('res://../runtime/')
 var evaluator=ClassDB.instantiate('SwgTerrainEvaluator')
 assert(evaluator!=null,'Native terrain evaluator missing')
 var manifest=JSON.parse_string(FileAccess.get_file_as_string(base+'assets/terrain/tatooine.json'))
 assert(evaluator.configure(manifest),'Invalid original terrain manifest')
 var report={'success':false,'source_reference_samples':0,'maximum_height_error':0.0,'references':[]}
 for file in ['reference-heights.tsv','road-reference.tsv']:
  if not FileAccess.file_exists(base+'terrain/'+file):continue
  var checked=0
  for line in FileAccess.get_file_as_string(base+'terrain/'+file).split('\n'):
   var row=line.replace('\\t','\t').split('\t')
   if row.size()!=4 or row[0]!='HEIGHT':continue
   var difference=abs(evaluator.sample_height(float(row[1]),float(row[2]))-float(row[3]))
   report.maximum_height_error=max(report.maximum_height_error,difference)
   assert(difference<.005,'Core3 height parity mismatch at '+line)
   checked+=1
  report.source_reference_samples+=checked
  report.references.append({'file':file,'samples':checked})
 var start=Time.get_ticks_usec()
 var a=evaluator.build_chunk(3520,-4864,128,64)
 var b=evaluator.build_chunk(3648,-4864,128,64)
 var coarse=evaluator.build_chunk(3648,-4864,128,8)
 report.three_chunks_ms=(Time.get_ticks_usec()-start)/1000.0
 assert(a.vertices.size()==4225 and a.indices.size()==24576)
 assert(a.shader_ids.size()==16900 and a.shader_weights.size()==4225 and a.tints.size()==4225)
 for row in range(65):
  assert(abs(a.vertices[row*65+64].y-b.vertices[row*65].y)<.00001,'Height seam')
  assert(a.normals[row*65+64].is_equal_approx(b.normals[row*65]),'Normal seam')
  if row%8==0:assert(abs(b.vertices[row*65].y-coarse.vertices[(row/8)*9].y)<.00001,'LOD sample seam')
 for i in range(0,a.indices.size(),3):
  var v0=a.vertices[a.indices[i]];var v1=a.vertices[a.indices[i+1]];var v2=a.vertices[a.indices[i+2]]
  assert((v1-v0).cross(v2-v0).y<0,'Winding differs from Godot PlaneMesh')
 for i in range(a.vertices.size()):
  assert(a.vertices[i].is_finite() and a.normals[i].is_finite())
  var w=a.shader_weights[i];assert(abs(w.r+w.g+w.b+w.a-1.0)<.001,'Material weights unnormalized')
 var cave=evaluator.sample(6556,-1305)
 assert(cave.excluded,'Source AEXC cave exclusion missing')
 var cave_chunk=evaluator.build_chunk(6528,-1344,128,64)
 assert(cave_chunk.excluded_cells>0 and cave_chunk.indices.size()<24576)
 var water=evaluator.sample(6675,5460)
 assert(water.water_enabled and water.water_height==1.0,'Original oasis water table missing')
 report.cave_excluded_cells=cave_chunk.excluded_cells
 report.source_water_verified=true
 report.seams_and_clockwise_winding=true
 report.color_ramps=manifest.color_ramps.size()
 report.success=true
 FileAccess.open(base+'terrain/native-validation.json',FileAccess.WRITE).store_string(JSON.stringify(report,'  '))
 print(JSON.stringify(report));quit()
