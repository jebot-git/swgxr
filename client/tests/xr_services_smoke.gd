extends SceneTree
## Mocked poses and real holographic interaction model; no headset/GPU claim.
const Services=preload("res://scripts/xr_services.gd")
var checks:=0
var failures: Array[String]=[]
var requests: Array=[]
func check(value: bool, message: String) -> void:
	checks+=1
	if not value: failures.append(message);push_error(message)
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var world:=Node3D.new();root.add_child(world)
	var rig:=XROrigin3D.new();world.add_child(rig)
	var camera:=XRCamera3D.new();camera.name="XRCamera3D";rig.add_child(camera);camera.position=Vector3(0,1.7,0)
	for side in ["LeftHand","RightHand"]:
		var hand:=XRController3D.new();hand.name=side;rig.add_child(hand)
	var body:=CharacterBody3D.new();world.add_child(body)
	var ui:=Services.new();world.add_child(ui);ui.configure(rig,body);ui.set_process(false);ui.set_allowed(true)
	ui.wallet_model_factory=func(): return Node3D.new()
	ui.action_requested.connect(func(action,payload): requests.append({"action":action,"payload":payload}))
	var pointed_screen: Dictionary={"id":"artisan","kind":"mission","position":Vector3(0,0,-2.1),"ui_anchors":[Transform3D(Basis.IDENTITY,Vector3(-0.14,1.27,-1.58))]}
	var adjacent_screen: Dictionary={"id":"scout","kind":"mission","position":Vector3(0.6,0,-2.1),"ui_anchors":[Transform3D(Basis.IDENTITY,Vector3(0.6,1.27,-1.58))]}
	var aim_origin:=Vector3(-0.14,1.27,0)
	check(ui.pointed_terminal([adjacent_screen,pointed_screen],Vector3.ZERO,aim_origin,Vector3.FORWARD).get("id")=="artisan","Original offset screen selected by aim, independent of nearby terminal order and old 1.8m origin limit")
	check(ui.pointed_terminal([pointed_screen],Vector3(0,0,4),aim_origin,Vector3.FORWARD).is_empty(),"Distant terminal cannot open")
	check(ui.pointed_terminal([pointed_screen],Vector3(0,0,-2),Vector3(-0.14,1.27,-3),Vector3.BACK).is_empty(),"Back of original terminal screen cannot be clicked through")
	ui.set_wallet({"cash":800,"bank":1200})
	var original_head:=camera.transform
	ui.open_terminal({"id":"10","kind":"bank","position":Vector3(0,0,-1),"name":"BANK"})
	check(requests.back().action=="open" and ui.pending,"Opening terminal requests live source and waits")
	var anchor:=ui.surface.global_transform
	camera.position.x+=0.3
	check(ui.surface.global_transform==anchor,"Terminal is static rather than following the head")
	ui.apply_response({"wallet":{"cash":800,"bank":1200},"terminal":{"id":"10","kind":"bank","name":"BANK"}})
	check(not ui.pending and ui.panel.slider.maximum==800,"Deposit uses confirmed carried balance")
	ui.panel.pointer_begin(Vector2(172,332));ui.panel.pointer_move(Vector2(428,332))
	ui.apply_response({"wallet":{"cash":800,"bank":1200},"terminal":{"id":"10","kind":"bank","name":"BANK"}},false)
	check(ui.panel.slider.dragging and ui.panel.pointer_down,"Unchanged status polling preserves finger drag and proposal")
	ui.panel.pointer_end(Vector2(428,332))
	check(ui.panel.slider.amount==400,"Physical slider drag computes integer credit amount")
	check(requests.size()==1 and ui.wallet.cash==800,"Dragging does not transfer or mutate wallet")
	ui.panel.click_at(Vector2(700,512))
	check(requests.back().action=="bank_transfer" and requests.back().payload.amount==400 and requests.back().payload.direction=="deposit","Explicit bank confirmation has server transfer payload")
	ui.panel.confirm()
	check(requests.size()==2,"Pending transfer cannot duplicate")
	ui.apply_response({"wallet":{"cash":400,"bank":1600},"mutation":{"success":true}})
	check(ui.wallet.cash==400 and ui.wallet.bank==1600,"Only native response updates balances")
	ui.panel.click_at(Vector2(570,222))
	check(ui.panel.direction=="withdraw" and ui.panel.slider.maximum==1600,"Withdrawal slider bounded by confirmed bank credits")
	ui.panel.slider.begin_drag(Vector2(24,42));ui.panel.slider.drag_to(Vector2(800,42));ui.panel.slider.cancel_drag()
	check(ui.panel.slider.amount==1600,"Slider clamps upper bound")
	ui.close_interface()
	check(not ui.surface.visible and ui.viewport.render_target_update_mode==SubViewport.UPDATE_DISABLED,"Closed UI stops offscreen redraw")
	ui.apply_response({"terminal":{"id":"10","kind":"bank"},"wallet":{"cash":400,"bank":1600}})
	check(ui.terminal.is_empty(),"Late terminal result does not reopen closed interface")
	ui.open_terminal({"id":"20","kind":"bazaar","position":Vector3(0,0,-1)})
	var listings: Array=[]
	for i in range(20): listings.append({"id":str(100+i),"name":"Item %d"%i,"price":80+i})
	ui.apply_response({"terminal":{"id":"20","kind":"bazaar","listings":listings}})
	ui.panel.pointer_begin(Vector2(350,200));ui.panel.pointer_move(Vector2(350,90));ui.panel.pointer_end(Vector2(350,90))
	check(ui.panel.offset==2 and ui.panel.selected==-1,"Finger drag scrolls rows without selecting or buying")
	ui.panel.pointer_begin(Vector2(350,150));ui.panel.pointer_end(Vector2(350,150))
	check(ui.panel.selected==2,"Finger click selects visible source row")
	ui.panel.confirm()
	check(requests.back().action=="bazaar_buy" and requests.back().payload.listing_id=="102" and requests.back().payload.price==82,"Purchase retains native listing and quote")
	ui.apply_response({"mutation":{"success":false,"error_code":"listing_changed"}})
	check(not ui.pending and ui.panel.message=="listing_changed","Native rejection displayed and no optimistic purchase")
	ui.panel.configure({"kind":"bazaar","id":"20","listings":[{"id":"500","name":"Auction","price":120,"auction":true,"buy_eligible":true,"min_bid":121}]},ui.wallet)
	ui.panel.click_at(Vector2(350,150))
	check(ui.panel.bid_mode and ui.panel.slider.minimum==121,"Auction selection uses source minimum bid and shared physical slider")
	ui.panel.slider.set_at(Vector2(-100,42))
	ui.panel.confirm()
	check(requests.back().payload.price==121,"Auction cannot submit below native minimum bid")
	ui.set_pending(false)
	ui.panel.configure({"kind":"bazaar","id":"20","listings":[{"id":"501","name":"Purchased item","retrieve_eligible":true,"buy_eligible":false,"status":2}]},ui.wallet)
	ui.panel.selected=0;ui.panel.confirm()
	check(requests.back().action=="bazaar_retrieve","Retrieval uses native eligibility, not guessed numeric status")
	ui.set_pending(false)
	ui.panel.configure({"kind":"mission","id":"30","missions":[{"id":"400","name":"Survey","active":false}]},ui.wallet)
	ui.panel.selected=0;ui.panel.confirm()
	check(requests.back().action=="mission_accept" and requests.back().payload.mission_id=="400","Mission selection sends native offer ID")
	ui.set_pending(false)
	var unsupported_mission: Dictionary={"id":"401","name":"Original delivery mission","supported":false,"blocked_reason":"Delivery requires NPC conversation, which is not implemented yet.","active":false}
	ui.panel.configure({"kind":"mission","id":"30","missions":[unsupported_mission]},ui.wallet)
	ui.panel.selected=0
	var mission_request_count:=requests.size()
	ui.panel.confirm()
	check(ui.panel.rows.size()==1 and ui.panel.rows[0].name=="Original delivery mission","Unsupported native mission offer remains visible with original identity")
	check(requests.size()==mission_request_count and not ui.panel.pending,"Unsupported mission Accept cannot emit a mutation or enter pending state")
	check(ui.panel.message==unsupported_mission.blocked_reason and ui.panel.mission_blocked_reason(unsupported_mission)==unsupported_mission.blocked_reason,"Native blocked reason is exposed for selected mission details")
	unsupported_mission.target="worrt lair";unsupported_mission.position=[3810,0,-4780];unsupported_mission.difficulty=5;unsupported_mission.reward=450
	var mission_detail: String=ui.panel.detail_for(unsupported_mission)
	check(mission_detail.contains("Target: worrt lair") and mission_detail.contains("X 3810 · Z -4780") and mission_detail.contains("Difficulty: 5") and mission_detail.contains("Reward: 450"),"Native objective target coordinates, difficulty and reward remain readable in mission details")
	check(not ui.panel.mission_blocked_reason({"supported":false,"blocked_reason":""}).is_empty(),"An empty native reason cannot accidentally enable an unsupported offer")
	unsupported_mission.active=true
	ui.panel.configure({"kind":"mission","id":"30","missions":[unsupported_mission]},ui.wallet)
	ui.panel.selected=0;ui.panel.confirm()
	check(requests.back().action=="mission_abort" and requests.back().payload.mission_id=="401","Existing unsupported mission can still be abandoned using native identity")
	ui.set_pending(false)
	unsupported_mission.active=false;unsupported_mission.supported=true
	ui.panel.configure({"kind":"mission","id":"30","missions":[unsupported_mission]},ui.wallet)
	ui.panel.selected=0;ui.panel.confirm()
	check(requests.back().action=="mission_accept" and ui.panel.mission_blocked_reason(unsupported_mission).is_empty(),"Source-supported mission remains acceptable even if an old reason field is present")
	ui.set_pending(false)
	ui.panel.configure({"kind":"mission","id":"30","missions":[]},ui.wallet)
	ui.panel.click_at(Vector2(100,515))
	check(requests.back().action=="mission_refresh","Refresh requests native mission offer regeneration")
	ui.set_pending(false)
	ui.panel.configure({"kind":"crafting","id":"31","tools":[{"id":"410","name":"Weapon tool"}]},ui.wallet)
	ui.panel.selected=0;ui.panel.confirm()
	check(requests.back().action=="crafting_station" and requests.back().payload.tool_id=="410","Crafting station use selects an owned native tool")
	ui.apply_response({"wallet":{"cash":400,"bank":1600}},false)
	check(ui.pending and ui.panel.pending,"Read-only refresh cannot unlock a pending mutation")
	ui.set_pending(false);ui.close_interface()
	var head:=Transform3D(Basis.IDENTITY,Vector3(0,1.7,0))
	var back:=Transform3D(Basis.IDENTITY,Vector3(0,1.08,0.22))
	check(ui.back_contains(head,back.origin),"Wallet lower-back gesture accepted")
	check(not ui.back_contains(head,Vector3(-0.19,1.54,0.12)),"Inventory shoulder gesture excluded")
	ui.update_wallet_gesture(true,head,back,0.9)
	check(not ui.wallet_held,"Starting with held grip cannot steal wallet")
	ui.update_wallet_gesture(true,head,back,0.1);ui.update_wallet_gesture(true,head,back,0.9)
	check(ui.wallet_held and ui.blocks_combat() and requests.back().action=="status","Fresh back grip holds wallet and refreshes native balances")
	check(ui.wallet_readout.text.contains("400 cr carried") and ui.wallet_readout.text.contains("1600 cr bank"),"Both native balances shown above wallet")
	var peer: Dictionary={"id":"500","name":"Recipient","hand_position":Vector3(0.3,1.2,-0.4),"grip":0.9,"fresh":true,"authenticated":true,"handshake_authorized":true}
	peer.handshake_authorized=false
	ui.show_payment(peer)
	check(ui.terminal.is_empty(),"Local overlap cannot bypass native handshake authorization")
	peer.handshake_authorized=true
	var shake:=Transform3D(Basis.IDENTITY,peer.hand_position)
	for i in range(5): ui.update_handshake(shake,0.9,[peer],0.1)
	check(ui.terminal.is_empty(),"Static overlap is not a handshake")
	for i in range(8):
		shake.origin.y=1.2+(0.012 if i%2==0 else -0.012)
		ui.update_handshake(shake,0.9,[peer],0.1)
	check(ui.terminal.get("kind","")=="payment" and ui.panel.target_id=="500","Deliberate grip handshake opens recipient payment proposal")
	peer.grip=0.0
	ui.validate_payment_peer([peer],body.global_position)
	check(ui.terminal.get("kind","")=="payment","Valid source handshake lease permits hand separation during slider use")
	peer.grip=0.9
	ui.panel.slider.configure(400,125);ui.panel.confirm()
	check(requests.back().action=="pay" and requests.back().payload.target_id=="500" and requests.back().payload.amount==125,"Payment requires explicit confirmation")
	ui.set_pending(false);ui.close_interface();ui.update_handshake(shake,0.9,[peer],0.1)
	check(ui.terminal.is_empty(),"One held handshake cannot reopen/repeat payment")
	ui.show_payment(peer)
	ui.validate_payment_peer([],body.global_position)
	check(ui.terminal.is_empty(),"Disconnected recipient closes payment slider")
	ui.update_wallet_gesture(true,head,back,0)
	check(not ui.wallet_held,"Released wallet returns to presentation storage")
	ui.update_wallet_gesture(true,head,back,0.9)
	peer.fresh=false
	for i in range(8):
		shake.origin.y=1.2+(0.012 if i%2==0 else -0.012)
		ui.update_handshake(shake,0.9,[peer],0.1)
	check(ui.terminal.is_empty(),"Stale remote hand cannot authorize payment selection")
	ui.update_wallet_gesture(false,head,back,0.9)
	check(not ui.wallet_held,"Tracking loss safely stows wallet")
	var shuttle: Dictionary={"id":"600","position":Vector3.ZERO,"landed":false,"doors_open":false,"boarding_radius":1.2}
	var held_tickets: Array=[{"id":"700","usable":true},{"id":"701","usable":false}]
	var count:=requests.size()
	ui.update_boarding(shuttle,held_tickets,Vector3(2,0,0),Vector3(1,0,0))
	check(requests.size()==count,"Closed flying shuttle cannot board")
	shuttle.landed=true;shuttle.doors_open=true
	ui.update_boarding(shuttle,held_tickets,Vector3(1,0,0),Vector3(1,0,0))
	check(requests.size()==count,"Landing on stationary player cannot initiate travel")
	ui.update_boarding(shuttle,held_tickets,Vector3(2,0,0),Vector3(1,0,0))
	check(requests.back().action=="travel_board" and requests.back().payload.ticket_id=="700","Walking through open door uses only valid source ticket")
	ui.set_pending(false)
	ui.update_boarding(shuttle,held_tickets,Vector3(2,0,0),Vector3(1,0,0))
	check(requests.size()==count+1,"Boarding threshold latch prevents duplicate request")
	ui.update_boarding(shuttle,held_tickets,Vector3(1,0,0),Vector3(3,0,0))
	held_tickets[1].usable=true
	ui.update_boarding(shuttle,held_tickets,Vector3(2,0,0),Vector3(1,0,0))
	check(ui.terminal.get("kind","")=="boarding" and ui.panel.rows.size()==2,"Multiple valid tickets open local destination chooser")
	ui.panel.selected=1
	var board_request_count:=requests.size()
	ui.sync_boarding_choices([held_tickets[1]])
	check(ui.panel.rows.size()==1 and ui.panel.selected==0 and requests.size()==board_request_count,"Ticket removal preserves still-valid selection without auto-boarding")
	ui.sync_boarding_choices(held_tickets)
	check(ui.panel.selected==1,"Refreshing available choices retains selected ticket identity")
	ui.sync_boarding_choices([held_tickets[0]])
	check(ui.panel.selected==-1,"Removed selected ticket cannot leave stale clickable selection")
	ui.sync_boarding_choices(held_tickets)
	ui.panel.selected=1;ui.panel.confirm()
	check(requests.back().payload.ticket_id=="701","Chooser boards selected actual ticket")
	ui.set_pending(false)
	ui.sync_boarding_choices([])
	check(ui.terminal.is_empty(),"No remaining usable tickets closes chooser")
	ui.terminal={"id":"test","kind":"bank"};ui.terminal_origin=Vector3.ZERO
	ui.update_proximity(Vector3(6,0,0))
	check(ui.terminal.is_empty(),"Walking away closes terminal or boarding chooser")
	ui.set_allowed(false)
	check(not ui.blocks_combat() and not ui.surface.visible,"Interaction disable closes all presentation")
	camera.transform=original_head
	check(body.global_position==Vector3.ZERO and rig.transform==Transform3D.IDENTITY,"Services never drive player physics or tracking")
	world.queue_free();await process_frame
	var result: Dictionary={"checks":checks,"failures":failures,"passed":failures.is_empty(),"renderer":"headless dummy","tracking":"mocked; not live XR"}
	var file:=FileAccess.open(ProjectSettings.globalize_path("res://../runtime/evidence/xr-services-smoke.json"),FileAccess.WRITE)
	if file!=null: file.store_string(JSON.stringify(result,"\t"))
	print(JSON.stringify(result));quit(0 if failures.is_empty() else 1)
