+void DotPackImplementation::fillAttributeList(AttributeListMessage* msg, CreatureObject* object) {
+    PharmaceuticalObjectImplementation::fillAttributeList(msg,object);
+    auto pack=_this.getReferenceUnsafeStaticCast();
+    msg->insertAttribute("Effect",isPoisonDeliveryUnit()?"Health poison":"Temporary Action disease");
+    msg->insertAttribute("Stacking","One shared Combat Medic channel per effect; stronger replaces weaker");
+    msg->insertAttribute("combat_healing_ability",getMedicineUseRequired());
+    msg->insertAttribute("Area recipient limit",isArea()?corecu::combatmedic::TargetCap:1);
+    if(isArea())msg->insertAttribute("examine_heal_area",String::valueOf(SwgxrCombatMedicEffects::radius(pack)));
+    if(object && object->isPlayerCreature()){
+        msg->insertAttribute("duration",SwgxrCombatMedicEffects::duration(object,pack));
+        msg->insertAttribute("examine_heal_range",String::valueOf(SwgxrCombatMedicEffects::range(object,pack)));
+        msg->insertAttribute("Application potency",String::valueOf(SwgxrCombatMedicEffects::rawPotency(object,pack))+" before target resistance; final chance capped at 95%");
+        int amount=SwgxrCombatMedicEffects::strength(object,object,pack);
+        msg->insertAttribute("Effect preview",String::valueOf(amount)+(isPoisonDeliveryUnit()?" total Health budget":" Action per 3 seconds"));
+        msg->insertAttribute("Preview scope","Viewer-sized recipient; target resistance shortens duration, absorption reduces pulses");
+    }
