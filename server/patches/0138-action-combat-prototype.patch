+   double turn=std::max(-limit,std::min(limit,error));
+   if(std::abs(turn)>1e-9){aim={{std::sin(current+turn),0,std::cos(current+turn)}};++aimRevision;changed=true;}
+  }
+  if(now>=lockAt()){aimLocked=true;changed=true;}
+  return changed;
+ }
