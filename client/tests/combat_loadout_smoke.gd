extends SceneTree
const Hologram=preload("res://scripts/equipment_hologram.gd")
const Loadout=preload("res://combat/loadout.gd")
const Inventory=preload("res://scripts/xr_inventory.gd")
class Player extends CharacterBody3D:
	func set_interface_capture(_move:bool,_turn:bool)->void:pass
var checks:=0
var errors:Array[String]=[]
var proposals:Array=[]
func check(ok:bool,message:String)->void:
	checks+=1
	if not ok:errors.append(message);push_error(message)
func _initialize()->void:call_deferred("run")
func fixture()->Dictionary:
	var value:Dictionary={"item_id":"99","ability_loadout":{"family":"pistols","slots":["lethal_shot","","",""],"ultimate":"","revision":1},"ability_catalog":[]}
	for id:String in ["lethal_shot","low_blow","restraining_shot","concussion_shot_improved","last_ditch"]:
		value.ability_catalog.append({"id":id,"label":id.replace("_"," ").capitalize(),"ultimate":id=="last_ditch","activation":"native_ranged","cooldown_seconds":30,"max_range_m":40})
	value.ability_catalog.back().profession_requirement="Smuggler"
	return value
func find(ui:Node3D,kind:String,id:="",index:=-1)->Dictionary:
	for row:Dictionary in ui.tiles:
		if row.kind==kind and (id.is_empty() or row.id==id) and (index<0 or row.index==index):return row
	return {}
func aim(row:Dictionary)->Transform3D:
	var node:Node3D=row.node
	return Transform3D(node.global_basis,node.global_position+node.global_basis.z*.3)
func confirm(ui:Node3D,value:Dictionary)->void:
	var snapshot:Dictionary=ui.context.duplicate(true);snapshot.ability_loadout=value.duplicate(true);snapshot.ability_loadout.revision+=1
	ui.observe(snapshot);ui.finish(true,"")
func drag_to(ui:Node3D,source:Dictionary,target:Dictionary)->void:
	ui.sample(aim(source),0,0,true);ui.sample(aim(source),1,0,true);ui.sample(aim(target),1,0,true);ui.sample(aim(target),0,0,true)
func run()->void:
	var world:=Node3D.new();root.add_child(world)
	var source:=preload("res://scripts/avatar.gd").new();world.add_child(source);var report:Dictionary=source.configure("human_male");source.set_process(false);source.hide()
	check(str(report.get("error","")).is_empty(),"Original avatar loaded")
	var hologram:=Hologram.new();world.add_child(hologram);hologram.configure(source,[]);hologram.set_ability_context(fixture());hologram.show_equipment(Transform3D.IDENTITY)
	var ui:Node3D=hologram.ability_editor;ui.proposed.connect(func(value):proposals.append(value.duplicate(true)))
	ui.toggle()
	check(ui.active and ui.tiles.filter(func(row):return row.kind=="slot").size()==4,"Exactly four combat slots above avatar")
	check(ui.tiles.filter(func(row):return row.kind=="ability").size()==4 and ui.tiles.filter(func(row):return row.kind=="ultimate").size()==1,"Separate regular grid and ultimate row")
	check(ui.lines.get_child_count()==1,"Only confirmed equipped slot draws anatomical connector")
	check(not hologram.labels[0].visible and hologram.equipped_at(Vector3.ZERO).is_empty(),"Ability editor reserves equipment pane and grip targets")
	var learned:=find(ui,"ability","low_blow");var destination:=find(ui,"slot","",1)
	ui.sample(aim(learned),1,0,true)
	check(ui.drag.is_empty(),"Held grip on open cannot start a drag")
	drag_to(ui,learned,destination)
	check(proposals.size()==1 and proposals[0].loadout.slots==["lethal_shot","low_blow","",""],"Drag/drop proposes ability into requested slot")
	check(ui.context.ability_loadout.slots[1]=="" and ui.pending and ui.lines.get_child_count()==1,"No optimistic equip or connector before Core3 confirms")
	ui.sample(aim(learned),0,0,true);ui.sample(aim(learned),1,0,true)
	check(proposals.size()==1 and ui.drag.is_empty(),"Pending save blocks repeated input")
	confirm(ui,proposals[0].loadout)
	check(ui.lines.get_child_count()==2 and ui.context.ability_loadout.slots[1]=="low_blow","Confirmed snapshot updates body connectors")
	var old:Dictionary=ui.context.ability_loadout.duplicate(true)
	drag_to(ui,find(ui,"slot","",1),find(ui,"slot","",0))
	check(proposals.back().loadout.slots==["low_blow","lethal_shot","",""],"Dragging equipped slots swaps without duplicates")
	ui.finish(false,"Rejected by Core3")
	check(ui.context.ability_loadout==old and hologram.labels[1].text=="Rejected by Core3","Rejected save retains confirmed layout and reports rejection")
	var ultimate:=find(ui,"ultimate","last_ditch")
	ui.describe("last_ditch")
	check("Requires Smuggler." in hologram.labels[1].text,"Ultimate description names its advanced profession")
	ui.sample(aim(ultimate),0,0,true);ui.sample(aim(ultimate),0,1,true)
	check(proposals.back().loadout.ultimate=="last_ditch" and proposals.back().loadout.slots==old.slots,"Ultimate click selects independently of four slots")
	confirm(ui,proposals.back().loadout)
	check(Loadout.equipped({"id":"last_ditch"},ui.context.ability_loadout),"Only selected ultimate is equipped")
	check(not Loadout.equipped({"id":"restraining_shot"},ui.context.ability_loadout),"Learned but unequipped regular ability is unavailable")
	check(not Loadout.equipped({"id":"other_ultimate","ultimate":true},ui.context.ability_loadout),"Other ultimate is unavailable")
	var count:=proposals.size();ui.sample(aim(find(ui,"ability","low_blow")),0,0,true);ui.sample(aim(find(ui,"ability","low_blow")),1,0,true)
	var heartbeat:Dictionary=ui.context.duplicate(true)
	heartbeat.ability_catalog[0].cooldown_remaining_seconds=3;heartbeat.ability_catalog[0].conditions_met=false;heartbeat.ability_catalog[0].damage_multiplier=4.2
	ui.observe(heartbeat)
	check(not ui.drag.is_empty(),"Cooldown/state/HAM heartbeat cannot cancel an in-progress drag")
	ui.sample(Transform3D.IDENTITY,0,0,false)
	check(ui.drag.is_empty() and proposals.size()==count,"Tracking loss cancels drag without saving")
	ui.sample(aim(find(ui,"ability","low_blow")),1,0,true)
	check(ui.drag.is_empty(),"Grip must release after tracking returns")
	drag_to(ui,find(ui,"slot","",1),find(ui,"ability","restraining_shot"))
	check(proposals.back().loadout.slots[1]=="","Dragging slot back to inventory clears it")
	confirm(ui,proposals.back().loadout)
	var other:=fixture();other.item_id="101";other.ability_loadout.family="carbines";other.ability_loadout.slots=["","","",""]
	ui.observe(other)
	check(ui.context.ability_loadout.family=="carbines" and ui.lines.get_child_count()==0,"Weapon-family switch uses its own confirmed slots")
	other.ability_loadout.family="2h_melee";other.ability_catalog=[];ui.observe(other)
	check(ui.tiles.size()==4 and "No learned abilities" in hologram.labels[1].text,"Melee family has four slots without fabricated native abilities")
	var tka:=fixture();tka.ability_loadout.family="unarmed";tka.ability_catalog=[{"id":"challenging_strike","label":"Challenging Strike"},{"id":"indomitable_focus","label":"Indomitable Focus","ultimate":true,"self_only":true,"profession_requirement":"Master Teras Kasi Artist","trigger_description":"Bring fists together and press both triggers.","cooldown_seconds":120},{"id":"tka_sweep","label":"Sweeping Punch","category":"gesture"}]
	ui.observe(tka)
	check(not find(ui,"ability","challenging_strike").is_empty() and not find(ui,"ultimate","indomitable_focus").is_empty() and not find(ui,"gesture","tka_sweep").is_empty(),"TKA separates target, ultimate and area gesture rows")
	ui.describe("indomitable_focus")
	check("fists together" in hologram.labels[1].text and "Master Teras Kasi" in hologram.labels[1].text and "Range:" not in hologram.labels[1].text,"Unarmed ultimate shows its own chord and self-buff requirement")
	var focus:=find(ui,"ultimate","indomitable_focus");ui.sample(aim(focus),0,0,true);ui.sample(aim(focus),0,1,true)
	check(proposals.back().loadout.ultimate=="indomitable_focus","TKA ultimate uses the single selected ultimate slot")
	ui.finish(false,"fixture reset")
	var sword:=fixture();sword.ability_loadout.family="2h_melee";sword.ability_loadout.slots=["","","",""];sword.ability_loadout.ultimate="";sword.ability_catalog=[]
	for id:String in ["rending_cut","disrupting_blow","hamstring","decisive_strike"]:sword.ability_catalog.append({"id":id,"label":id.capitalize()})
	sword.ability_catalog.append({"id":"armour_break","label":"Armour Break","ultimate":true,"profession_requirement":"Master Swordsman","trigger_description":"Hold with both hands, aim and press both triggers.","cooldown_seconds":120})
	for id:String in ["overhead_cleave","ground_slam"]:sword.ability_catalog.append({"id":id,"label":id.capitalize(),"category":"gesture","trigger_description":"Two-handed downward strike with triggers released."})
	ui.observe(sword)
	check(ui.tiles.filter(func(row):return row.kind=="slot").size()==4 and not find(ui,"gesture","ground_slam").is_empty() and not find(ui,"ultimate","armour_break").is_empty(),"Swordsman has four slots, independent gesture row and one ultimate")
	drag_to(ui,find(ui,"ability","rending_cut"),find(ui,"slot","",0));confirm(ui,proposals.back().loadout)
	check(ui.lines.get_child_count()==1,"Swordsman torso ability draws its anatomical slot connector")
	ui.describe("armour_break");check("Master Swordsman" in hologram.labels[1].text and "both triggers" in hologram.labels[1].text,"Armour Break describes its advanced profession and chord")
	var armour_break:=find(ui,"ultimate","armour_break");ui.sample(aim(armour_break),0,0,true);ui.sample(aim(armour_break),0,1,true)
	check(proposals.back().loadout.ultimate=="armour_break","Armour Break equips with one click")
	ui.finish(false,"fixture reset")
	var fencer:=fixture();fencer.ability_loadout.family="1h_melee";fencer.ability_loadout.slots=["","","",""];fencer.ability_loadout.ultimate="";fencer.ability_catalog=[]
	for id:String in ["arterial_cut","nerve_strike","disorienting_thrust","exposing_thrust"]:fencer.ability_catalog.append({"id":id,"label":id.capitalize()})
	fencer.ability_catalog.append({"id":"flawless_assault","label":"Flawless Assault","ultimate":true,"self_only":true,"profession_requirement":"Master Fencer","trigger_description":"Support the weapon and press both triggers.","cooldown_seconds":120})
	for id:String in ["probing_jabs","raking_slash","guard_bash"]:fencer.ability_catalog.append({"id":id,"label":id.capitalize(),"category":"gesture","trigger_description":"Hold grip and release trigger before the gesture."})
	ui.observe(fencer)
	check(ui.tiles.filter(func(row):return row.kind=="slot").size()==4 and not find(ui,"gesture","probing_jabs").is_empty() and not find(ui,"ultimate","flawless_assault").is_empty(),"Fencer retains four slots with separate gestures and ultimate")
	drag_to(ui,find(ui,"ability","arterial_cut"),find(ui,"slot","",0));confirm(ui,proposals.back().loadout)
	check(ui.lines.get_child_count()==1,"Arterial Cut draws torso connector")
	ui.describe("flawless_assault");check("Master Fencer" in hologram.labels[1].text and "both triggers" in hologram.labels[1].text and "Range:" not in hologram.labels[1].text,"Flawless Assault describes profession, support chord and self buff")
	var flawless:=find(ui,"ultimate","flawless_assault");ui.sample(aim(flawless),0,0,true);ui.sample(aim(flawless),0,1,true)
	check(proposals.back().loadout.ultimate=="flawless_assault","Flawless Assault selects with one click")
	ui.finish(false,"fixture reset")
	var before_fencer:=proposals.size()
	drag_to(ui,find(ui,"gesture","probing_jabs"),find(ui,"slot","",1))
	check(proposals.size()==before_fencer,"Fencer gesture cannot occupy a VATS slot")
	ui.scroll(1);check(not find(ui,"gesture","guard_bash").is_empty(),"Fencer gesture pagination exposes third trigger")
	var pike:=fixture();pike.ability_loadout.family="polearms";pike.ability_loadout.slots=["knockdown_strike","polearm_stun","",""];pike.ability_loadout.ultimate="";pike.ability_catalog=[]
	for id:String in ["knockdown_strike","polearm_stun","pinning_strike","disrupting_jab"]:pike.ability_catalog.append({"id":id,"label":id.capitalize()})
	pike.ability_catalog.append({"id":"whirlwind","label":"Whirlwind","ultimate":true,"profession_requirement":"Master Pikeman","trigger_description":"Hold with both hands and press both triggers.","cooldown_seconds":120})
	for id:String in ["overhead_whirl","sweeping_trip","driving_jabs"]:pike.ability_catalog.append({"id":id,"label":id.capitalize(),"category":"gesture","trigger_description":"Hold polearm with both hands and triggers released."})
	ui.observe(pike)
	check(ui.tiles.filter(func(row):return row.kind=="slot").size()==4 and ui.lines.get_child_count()==2,"Pikeman retains inherited slots and anatomical connectors")
	check(ui.tiles.filter(func(row):return row.kind=="ability").size()==4,"Shared knockdown/stun IDs do not create duplicate inventory entries")
	drag_to(ui,find(ui,"ability","pinning_strike"),find(ui,"slot","",2));confirm(ui,proposals.back().loadout)
	check(ui.lines.get_child_count()==3,"Pinning Strike adds its foot connector")
	ui.describe("whirlwind");check("Master Pikeman" in hologram.labels[1].text and "both triggers" in hologram.labels[1].text,"Whirlwind describes exclusive profession and chord")
	var whirlwind:=find(ui,"ultimate","whirlwind");ui.sample(aim(whirlwind),0,0,true);ui.sample(aim(whirlwind),0,1,true)
	check(proposals.back().loadout.ultimate=="whirlwind","Whirlwind selects independently with one click")
	ui.finish(false,"fixture reset")
	var before_pike:=proposals.size();drag_to(ui,find(ui,"gesture","overhead_whirl"),find(ui,"slot","",3));check(proposals.size()==before_pike,"Pikeman gesture cannot occupy targeting slot")
	ui.scroll(1);check(not find(ui,"gesture","driving_jabs").is_empty(),"Pikeman third gesture remains reachable")
	var many:=fixture()
	for i in range(12):many.ability_catalog.append({"id":"extra_%d"%i,"label":"Extra %d"%i,"ultimate":false})
	for i in range(4):many.ability_catalog.append({"id":"ultimate_%d"%i,"label":"Ultimate %d"%i,"ultimate":true})
	ui.observe(many);ui.scroll(99)
	check(ui.page==2 and not find(ui,"ability","extra_11").is_empty() and not find(ui,"ultimate","ultimate_3").is_empty(),"Pagination reaches all combat abilities and ultimates")
	var gesture_catalog:=fixture()
	for id:String in ["warcry","taunt","feign_death"]:
		gesture_catalog.ability_catalog.append({"id":id,"label":id.capitalize(),"category":"gesture","trigger_description":"Raise the weapon and pump upward.","weapon_requirement":"Requires a compatible weapon.","description":"Support ability."})
	ui.observe(gesture_catalog)
	check(find(ui,"ability","warcry").is_empty() and not find(ui,"gesture","warcry").is_empty(),"Gesture abilities have their own row outside regular slots")
	var before_gesture:=proposals.size()
	var gesture_tile:=find(ui,"gesture","warcry")
	drag_to(ui,gesture_tile,find(ui,"slot","",2))
	check(proposals.size()==before_gesture and ui.drag.is_empty(),"Gesture cannot be dragged into a targeting slot")
	ui.sample(aim(gesture_tile),0,0,true);ui.sample(aim(gesture_tile),0,1,true)
	check(proposals.size()==before_gesture and "TRIGGER" in hologram.labels[1].text and "compatible weapon" in hologram.labels[1].text and "No targeting slot" in hologram.labels[1].text,"Gesture click shows trigger/restrictions without equipping or activating")
	check(not Loadout.equipped({"id":"warcry","category":"gesture"},{"slots":["warcry","","",""],"ultimate":""}),"Stale gesture assignment never counts as targeting equipment")
	check(ui.tiles.filter(func(row):return row.kind=="slot").size()==4 and not find(ui,"ultimate","last_ditch").is_empty(),"Four targeted slots and ultimate remain independent of gestures")
	ui.scroll(1)
	check(not find(ui,"gesture","feign_death").is_empty(),"Gesture pagination reaches additional support abilities")
	for row:Dictionary in ui.tiles:
		if row.kind!="slot":check(absf(row.node.position.y)+.03<.235,"Every ability row stays inside expanded panel")
	ui.toggle();check(is_equal_approx(hologram.panels[0].get_child(0).mesh.size.y,.36),"Closing ability editor restores equipment panel size")
	var xr:=XROrigin3D.new();world.add_child(xr);var camera:=XRCamera3D.new();camera.name="XRCamera3D";xr.add_child(camera)
	for side in ["LeftHand","RightHand"]:var hand:=XRController3D.new();hand.name=side;xr.add_child(hand)
	var body:=Player.new();world.add_child(body)
	var inventory:=Inventory.new();world.add_child(inventory);inventory.configure(xr,body,"right");inventory.set_process(false);inventory.allowed=true
	inventory.set_equipment_context(source,[]);inventory.browse_equipment(Transform3D.IDENTITY);inventory.set_combat_loadout_context(fixture(),Callable())
	inventory.sample_ability_editor(true,Transform3D.IDENTITY,0,0,true)
	check(not inventory.hologram.ability_editor.active,"Held right stick cannot open editor")
	inventory.sample_ability_editor(false,Transform3D.IDENTITY,0,0,true);inventory.sample_ability_editor(true,Transform3D.IDENTITY,0,0,true)
	check(inventory.hologram.ability_editor.active and inventory.blocks_combat(),"Fresh physical right stick opens editor for left-handed setup and blocks combat")
	inventory.update_gestures(true,Transform3D.IDENTITY,Transform3D.IDENTITY,1,1,{},Transform3D.IDENTITY)
	check(inventory.equipment_drag.is_empty(),"Ability editor prevents equipment pickup gestures")
	inventory.sample_ability_editor(false,Transform3D.IDENTITY,0,0,true);inventory.sample_ability_editor(true,Transform3D.IDENTITY,0,0,true)
	check(not inventory.hologram.ability_editor.active and inventory.hologram.active,"Second click returns to equipment hologram")
	print(JSON.stringify({"checks":checks,"passed":errors.is_empty(),"errors":errors,"renderer":"dummy","native_transport":"mocked","live_xr":false}))
	world.free();quit(0 if errors.is_empty() else 1)
