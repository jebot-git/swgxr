+#ifndef SWGXR_LIVE_RECOVERY_H
+#define SWGXR_LIVE_RECOVERY_H
+#include <chrono>
+#include <cstdint>
+#include <algorithm>
+#include <map>
+#include <mutex>
+// Only registered live VR sessions change original automatic incapacitation recovery.
+// A 60-second lease fails open after disconnect; ordinary players never enter this map.
+class SwgxrLiveRecovery {
+ struct Entry {double touched=0,duration=1,deadline=0;bool requested=false;};
+ static std::map<std::uint64_t,Entry>& entries(){static std::map<std::uint64_t,Entry> value;return value;}
+ static std::mutex& mutex(){static std::mutex value;return value;}
+ static double now(){return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();}
+public:
+ static void attach(std::uint64_t id,double remaining){std::lock_guard<std::mutex> lock(mutex());entries()[id]={now(),std::max(1.0,std::min(60.0,remaining)),0,false};}
+ static void detach(std::uint64_t id){std::lock_guard<std::mutex> lock(mutex());entries().erase(id);}
+ static void touch(std::uint64_t id,bool incapacitated){std::lock_guard<std::mutex> lock(mutex());auto it=entries().find(id);if(it==entries().end())return;it->second.touched=now();if(!incapacitated){it->second.requested=false;it->second.deadline=0;}}
+ static void duration(std::uint64_t id,double seconds){std::lock_guard<std::mutex> lock(mutex());auto it=entries().find(id);if(it==entries().end())return;it->second.duration=std::max(1.0,std::min(60.0,seconds));it->second.requested=false;it->second.deadline=0;}
+ static bool request(std::uint64_t id){std::lock_guard<std::mutex> lock(mutex());auto it=entries().find(id);if(it==entries().end())return false;auto& e=it->second;if(!e.requested){e.requested=true;e.deadline=now()+e.duration;}return true;}
+ static double remaining(std::uint64_t id){std::lock_guard<std::mutex> lock(mutex());auto it=entries().find(id);if(it==entries().end() || !it->second.requested)return -1;return std::max(0.0,it->second.deadline-now());}
+ static bool blocked(std::uint64_t id){std::lock_guard<std::mutex> lock(mutex());auto it=entries().find(id);if(it==entries().end())return false;if(now()-it->second.touched>60){entries().erase(it);return false;}return !it->second.requested || now()<it->second.deadline;}
+};
+#endif
